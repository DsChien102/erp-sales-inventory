# Shared deploy secrets (iOS TestFlight / App Store Connect).
# Copy: cp config/secrets/deploy.env.example config/secrets/deploy.env
#
# Used by deploy-ios.sh for all flavors (staging + production).
# Not synced to apps/erp/.env — keeps ASC keys out of --dart-define-from-file.

APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_IDENTIFIER=
# API key file (.p8): ~/.appstoreconnect/private_keys/AuthKey_<KEY_IDENTIFIER>.p8
