SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_TICK_SECRET=

LOG_LEVEL=
MESSAGING_CLIENT_POLL_ENABLED=false
