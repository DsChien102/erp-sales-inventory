# Optional overrides for `local` environment (Supabase CLI auto-fill).
# Copy only when you need manual overrides on top of `supabase status`:
#   cp config/secrets/local.env.example config/secrets/local.env
#
# For remote dev Supabase, use `development` (default): config/secrets/development.env

# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# WORKER_TICK_SECRET=
