{
  "default": "development",
  "deploySecretsFile": "config/secrets/deploy.env",
  "environments": {
    "development": {
      "description": "Remote dev — secrets + supabase link on use/sync",
      "secretsFile": "config/secrets/development.env",
      "supabaseSource": "secrets",
      "erp": {
        "flavor": "development",
        "envFile": "apps/erp/.env",
        "appEnv": "development"
      },
      "worker": {
        "envFile": "apps/messaging_worker/.env",
        "dockerSupabaseUrl": "http://host.docker.internal:54321"
      }
    },
    "local": {
      "description": "Local supabase start — supabase status only, no link",
      "secretsFile": "config/secrets/local.env",
      "supabaseSource": "supabase_cli",
      "syncSupabaseLink": false,
      "erp": {
        "flavor": "development",
        "envFile": "apps/erp/.env",
        "appEnv": "development"
      },
      "worker": {
        "envFile": "apps/messaging_worker/.env",
        "dockerSupabaseUrl": "http://host.docker.internal:54321"
      }
    },
    "staging": {
      "description": "Remote Supabase staging + staging flavor",
      "secretsFile": "config/secrets/staging.env",
      "supabaseSource": "secrets",
      "railwayEnvironment": "staging",
      "erp": {
        "flavor": "staging",
        "envFile": "apps/erp/.env.staging",
        "appEnv": "staging"
      },
      "worker": {
        "envFile": "apps/messaging_worker/.env.staging"
      }
    },
    "production": {
      "description": "Remote Supabase production + production flavor",
      "secretsFile": "config/secrets/production.env",
      "supabaseSource": "secrets",
      "railwayEnvironment": "production",
      "erp": {
        "flavor": "production",
        "envFile": "apps/erp/.env.production",
        "appEnv": "production"
      },
      "worker": {
        "envFile": "apps/messaging_worker/.env.production"
      }
    }
  }
}
