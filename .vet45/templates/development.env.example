# Development secrets (remote dev project):
#   cp .vet45/profiles/<profileId>/development.env.example .vet45/profiles/<profileId>/development.env
#
# melos run env:use / env:sync runs supabase link to match this env.
# For supabase start on localhost, use: melos run env:local

SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_TICK_SECRET=

LOG_LEVEL=
MESSAGING_CLIENT_POLL_ENABLED=false

WORKER_LOG_LEVEL=WARNING
WORKER_TENANT_BATCH_SIZE=20
WORKER_MODULE_BATCH_SIZE=10
WORKER_MAX_ROUNDS_PER_TICK=5
WORKER_TICK_ACTIVE_SECONDS=3
WORKER_TICK_IDLE_SECONDS=15
WORKER_TICK_MAX_IDLE_SECONDS=30
PORT=8080
