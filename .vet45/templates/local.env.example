# Optional overrides for `local` environment (Supabase CLI auto-fill).
# Copy only when you need manual overrides on top of `supabase status`:
#   cp .vet45/profiles/<profileId>/local.env.example .vet45/profiles/<profileId>/local.env

# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# WORKER_TICK_SECRET=

# WORKER_LOG_LEVEL=FINE
# WORKER_TENANT_BATCH_SIZE=20
# WORKER_MODULE_BATCH_SIZE=10
# WORKER_MAX_ROUNDS_PER_TICK=5
# WORKER_TICK_ACTIVE_SECONDS=3
# WORKER_TICK_IDLE_SECONDS=15
# WORKER_TICK_MAX_IDLE_SECONDS=30
# PORT=8080
