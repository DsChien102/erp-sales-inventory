APP_ENV=development

APP_STORE_CONNECT_ISSUER_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
APP_STORE_CONNECT_KEY_IDENTIFIER=ABC1234567

SUPABASE_CONNECTION_URL=
SUPABASE_ANON_KEY=

# Optional. Filters app logs: FINE, INFO, WARNING, SEVERE, OFF, etc.
# Leave empty to use FINE in debug builds and INFO in release/profile.
# Override: flutter run --dart-define=LOG_LEVEL=WARNING
#
# Local dev: melos run debug (uses this file via envied).
# Flavored runs: melos run debug:staging --dart-define-from-file=.env.staging
LOG_LEVEL=

# Client periodic messaging poll. Server worker self-loop handles 24/7 backlog.
MESSAGING_CLIENT_POLL_ENABLED=false