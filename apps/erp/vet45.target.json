{
  "version": 1,
  "id": "erp",
  "description": "Flutter ERP",
  "kind": "flutter",
  "keys": [
    {
      "name": "APP_ENV",
      "fromManifest": "appEnv"
    },
    {
      "name": "SUPABASE_CONNECTION_URL",
      "from": "SUPABASE_URL",
      "required": true
    },
    {
      "name": "SUPABASE_ANON_KEY",
      "required": true
    },
    {
      "name": "LOG_LEVEL",
      "default": "INFO"
    },
    {
      "name": "MESSAGING_CLIENT_POLL_ENABLED",
      "default": "false"
    }
  ],
  "environments": {
    "development": {
      "envFile": ".env",
      "flavor": "development",
      "appEnv": "development"
    },
    "local": {
      "envFile": ".env",
      "flavor": "development",
      "appEnv": "development"
    },
    "staging": {
      "envFile": ".env.staging",
      "flavor": "staging",
      "appEnv": "staging"
    },
    "production": {
      "envFile": ".env.production",
      "flavor": "production",
      "appEnv": "production"
    }
  },
  "actions": {
    "debug": {
      "command": "flutter",
      "args": [
        "run",
        "--flavor",
        "{{flavor}}",
        "--dart-define-from-file={{envBasename}}"
      ],
      "cwd": ".",
      "requireEnvFile": true
    },
    "debug:web": {
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "chrome",
        "--flavor",
        "{{flavor}}",
        "--dart-define-from-file={{envBasename}}"
      ],
      "cwd": ".",
      "requireEnvFile": true
    },
    "debug:ios": {
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "ios",
        "--flavor",
        "{{flavor}}",
        "--dart-define-from-file={{envBasename}}"
      ],
      "cwd": ".",
      "platforms": ["macos"],
      "requireEnvFile": true
    },
    "build-ios": {
      "command": "./scripts/build_ios.sh",
      "args": ["--env", "{{environmentId}}"],
      "cwd": ".",
      "platforms": ["macos"],
      "requireEnvironments": ["staging", "production"]
    },
    "deploy-ios": {
      "command": "./deploy-ios.sh",
      "args": ["--env", "{{environmentId}}"],
      "cwd": ".",
      "platforms": ["macos"],
      "requireEnvironments": ["staging", "production"],
      "requireDoctorTargets": ["deploy"],
      "preActions": ["build-ios"]
    }
  }
}
