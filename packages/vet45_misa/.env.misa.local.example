# Copy to .env.misa.local (gitignored via .env*.local) and fill in values.
# Prefer test API until publish payload is confirmed.

MISA_MEINVOICE_BASE_URL=https://testapi.meinvoice.vn/api/integration
MISA_MEINVOICE_APP_ID=
MISA_MEINVOICE_TAX_CODE=
MISA_MEINVOICE_USERNAME=
MISA_MEINVOICE_PASSWORD=

# templates / publish
MISA_MEINVOICE_WITH_CODE=true

# optional publish overrides (else first active template is used)
# MISA_MEINVOICE_TEMPLATE_ID=
# MISA_MEINVOICE_SERIES=
# MISA_MEINVOICE_BUYER_NAME=
# MISA_MEINVOICE_BUYER_TAX_CODE=
# MISA_MEINVOICE_BUYER_ADDRESS=
# MISA_MEINVOICE_BUYER_EMAIL=
# MISA_MEINVOICE_REF_ID=

# status / download when not using `all`
# MISA_MEINVOICE_TRANSACTION_ID=
# MISA_MEINVOICE_DOWNLOAD_FORMAT=pdf

# REQUIRED for `publish` and `all` (safety latch)
# MISA_SMOKE_CONFIRM_PUBLISH=1

# Prefer: dart run tool/smoke_me_invoice.dart token  → .meinvoice_token.local
# Optional override instead of token file:
# MISA_MEINVOICE_ACCESS_TOKEN=
# MISA_MEINVOICE_ACCESS_TOKEN_EXPIRES_AT=2026-08-28T00:00:00Z
